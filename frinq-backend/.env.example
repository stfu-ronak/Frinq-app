# Copy to .env and fill in real values. Never commit .env.
# Every key here mirrors app/config.py — keep them in sync.

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

# Database (asyncpg)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Anthropic
ANTHROPIC_API_KEY=

# OpenAI / ChatGPT
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=medium

# Voyage (embeddings)
VOYAGE_API_KEY=

# Which provider generates the hero-card profile fields (openai|claude)
INSIGHTS_PROVIDER=openai

# Redis
REDIS_URL=redis://localhost:6379/0

# Twilio Verify (OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
OTP_CHANNEL=whatsapp
DUMMY_OTP=
DEV_PHONE=
ALLOW_TEST_OTP_IN_PROD=false
SKIP_OTP_VERIFICATION=false

# Twilio Messaging API (proactive WhatsApp send)
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TEMPLATE_SID=
TWILIO_WHATSAPP_FOLLOWUP_TEMPLATE_SID=

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# Admin
ADMIN_KEY=change-me-strong-random-value
ADMIN_ACTION_PASSWORD=change-me-strong-random-value

# CORS — comma-separated allowed origins, empty = deny all
CORS_ORIGINS=https://app.frinq.in

# App
APP_ENV=development
SECRET_KEY=change-me-strong-random-value

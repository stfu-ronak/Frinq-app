# Copy to .env and fill in real values. Never commit .env.
# Every key here mirrors app/config.py — keep them in sync.

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

# Database (asyncpg)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Anthropic
ANTHROPIC_API_KEY=

# OpenAI / ChatGPT
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=medium

# Voyage (embeddings)
VOYAGE_API_KEY=

# Legacy fallback provider for direct insight calls (openai|claude|gemini).
# Production jobs use the admin-controlled ai_model_config rows.
INSIGHTS_PROVIDER=openai

# Redis
REDIS_URL=redis://localhost:6379/0

# Twilio Verify (OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
OTP_CHANNEL=whatsapp
DUMMY_OTP=123456
DEV_PHONE=8000000001
ALLOW_TEST_OTP_IN_PROD=false
SKIP_OTP_VERIFICATION=false
TEST_PHONES=8000000001,8000000002,8000000003
GEMINI_API_KEY=
REVIEW_PHONE=
REVIEW_OTP=
REVIEW_OTP_EXPIRES_AT=

# Twilio Messaging API (proactive WhatsApp send)
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TEMPLATE_SID=
TWILIO_WHATSAPP_FOLLOWUP_TEMPLATE_SID=

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# Admin
ADMIN_KEY=change-me-strong-random-value
ADMIN_ACTION_PASSWORD=change-me-strong-random-value
ADMIN_ACTOR_ID=admin

# CORS — comma-separated allowed origins, empty = deny all
CORS_ORIGINS=https://app.frinq.in

# App
APP_ENV=development
SECRET_KEY=change-me-strong-random-value

# Sessions — separate pepper for hashing refresh-token secrets (not the JWT key)
SESSION_HASH_PEPPER=change-me-strong-random-value

# Rate limiting — separate pepper for hashing phone/IP rate-limit keys
RATE_LIMIT_PEPPER=change-me-strong-random-value

# Chat moderation — comma-separated blocked substrings, case-insensitive (optional)
MODERATION_BLOCKED_TERMS=

# Push notifications — separate pepper for hashing stored FCM/APNs tokens,
# and a Fernet key for reversibly encrypting them at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PUSH_TOKEN_HASH_PEPPER=change-me-strong-random-value
PUSH_TOKEN_ENCRYPTION_KEY=change-me-fernet-key

# Firebase Cloud Messaging — inline service-account JSON (not a file path).
# Empty = push send is a no-op (logged only), everything else still works.
FCM_SERVICE_ACCOUNT_JSON=

# Azure AI Foundry (v1) — OpenAI-COMPATIBLE surface: same body/auth as
# api.openai.com, only the host differs. Set provider="azure" per step in
# the admin panel. AZURE_OPENAI_API_KEY falls back to OPENAI_API_KEY.
# Azure AI Foundry v1 base (OpenAI-compatible), i.e. ends in /openai/v1:
#   https://<resource>.services.ai.azure.com/openai/v1
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Optional JSON map model_id -> deployment name, e.g.
# {"gpt-5.6-luna":"luna-deploy","gpt-5.6-terra":"terra-deploy"}
AZURE_OPENAI_DEPLOYMENTS=

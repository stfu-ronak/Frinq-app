{
  "name": "FrinqMobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "verify:config": "node scripts/verify-native-config.mjs",
    "verify:no-webview": "node scripts/verify-no-webview.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "verify:contracts": "node scripts/verify-contracts.mjs",
    "verify:release-artifact": "node scripts/verify-release-artifact.mjs",
    "verify:store-assets": "node scripts/verify-store-assets.mjs",
    "contracts:refresh": "node scripts/refresh-contracts-snapshot.mjs",
    "link-fonts": "react-native-asset",
    "verify": "npm run typecheck && npm run lint && npm test -- --runInBand && npm run verify:config && npm run verify:no-webview && npm run verify:assets && npm run verify:contracts && npm run verify:store-assets",
    "android:debug": "react-native run-android",
    "android:release-check": "cd android && gradlew.bat lintRelease testReleaseUnitTest assembleRelease"
  },
  "dependencies": {
    "@dr.pogodin/react-native-fs": "^2.39.2",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-firebase/analytics": "^25.1.0",
    "@react-native-firebase/app": "^25.1.0",
    "@react-native-firebase/messaging": "^25.1.0",
    "@react-native/new-app-screen": "0.86.0",
    "@react-navigation/bottom-tabs": "^7.18.13",
    "@react-navigation/native": "^7.3.13",
    "@react-navigation/native-stack": "^7.18.5",
    "@tanstack/react-query": "^5.101.4",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-audio-api": "^0.12.2",
    "react-native-gesture-handler": "^3.1.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-haptic-feedback": "^3.0.0",
    "react-native-keychain": "^10.0.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-reanimated": "^4.5.3",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.26.2",
    "react-native-share": "^12.3.1",
    "react-native-svg": "^15.15.5",
    "react-native-view-shot": "^5.1.1",
    "react-native-worklets": "^0.11.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/jest-preset": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "sharp": "^0.35.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
